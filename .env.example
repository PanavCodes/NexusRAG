# =====================================================================
# NexusRAG - Environment Configuration Template
# =====================================================================
# Copy this file to '.env' and populate your API keys:
#    cp .env.example .env (Linux/macOS)
#    copy .env.example .env (Windows)
# =====================================================================

# 1. Google Gemini API Key
# Obtain a free API key from Google AI Studio:
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenRouter API Key
# Obtain a free API key from OpenRouter:
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 3. Pipeline & Network Guardrail Settings (Defaults shown)
NEXUSRAG_CONNECT_TIMEOUT=10
NEXUSRAG_WEBSITE_TIMEOUT=60
NEXUSRAG_MAX_FILES=100
NEXUSRAG_GIT_TIMEOUT=180
